# Never commit a node's credentials. The bearer token is the only durable
# state the service keeps; everything else is re-obtained from the server.
*.token
token
.env
.env

# Correspondence with the server author. Deliberately untracked: these are
# outbound drafts that get rewritten between sends and would otherwise read as
# a second, competing spec. The durable record lives in docs/open-questions.md,
# which is where an answer should land once one arrives.
docs/for-server-author.*
docs/node-ingest-v1.annotated.yml
tools/annotate-spec.py
